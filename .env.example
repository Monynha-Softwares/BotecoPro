# Firebase Configuration
# Copy this file to .env and fill in your Firebase credentials

# Web
FIREBASE_API_KEY_WEB=your-web-api-key
FIREBASE_APP_ID_WEB=your-web-app-id
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Android
FIREBASE_API_KEY_ANDROID=your-android-api-key
FIREBASE_APP_ID_ANDROID=your-android-app-id

# iOS
FIREBASE_API_KEY_IOS=your-ios-api-key
FIREBASE_APP_ID_IOS=your-ios-app-id
FIREBASE_IOS_BUNDLE_ID=com.example.botecoPro

# macOS
FIREBASE_API_KEY_MACOS=your-macos-api-key
FIREBASE_APP_ID_MACOS=your-macos-app-id

# Windows
FIREBASE_API_KEY_WINDOWS=your-windows-api-key
FIREBASE_APP_ID_WINDOWS=your-windows-app-id

# Linux
FIREBASE_API_KEY_LINUX=your-linux-api-key
FIREBASE_APP_ID_LINUX=your-linux-app-id
