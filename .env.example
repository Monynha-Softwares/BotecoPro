# BotecoPro - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas chaves reais

# ============================================
# CLERK AUTHENTICATION
# ============================================
# Obtenha sua chave em: https://dashboard.clerk.com
# Navegue para: Seu Projeto > API Keys > Publishable Key
# 
# Formato: pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (desenvolvimento)
#          pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (produção)
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_CLERK_KEY

# ============================================
# CONFIGURAÇÕES FUTURAS
# ============================================
# Adicione outras variáveis de ambiente conforme necessário
# Exemplos:
# API_BASE_URL=https://api.example.com
# ENABLE_ANALYTICS=true
# ENVIRONMENT=development

# ============================================
# SUPABASE DATABASE (OPCIONAL)
# ============================================
# Para usar Supabase em vez de SharedPreferences local:
# 1. Obtenha suas credenciais em: https://app.supabase.com
# 2. Navegue para: Seu Projeto > Settings > API
# 3. Copie a URL e a anon/public key
# 4. Compile com: flutter run -d web --dart-define=USE_SUPABASE=true
#
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
